# ===== Supabase 项目配置（必须）=====
# 在 https://supabase.com 免费注册项目后，从 Project Settings -> API 获取
NEXT_PUBLIC_SUPABASE_URL=https://你的项目.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的anon_public_key

# 服务端专用（仅在 API 路由中使用，绝不能暴露给浏览器、不要提交到公开仓库）
# Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=你的service_role_key

# ===== 校园准入配置（必须）=====
# 允许注册的学校邮箱后缀，多个用逗号分隔，例如：
# NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=stu.xxx.edu.cn,xxx.edu.cn
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=stu.example.edu.cn
